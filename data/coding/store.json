      "outputFormat": "Two space-separated indices (0-based).",
      "constraints": "2 <= n <= 10^4\n-10^9 <= nums[i] <= 10^9\n-10^9 <= target <= 10^9",
      "examples": [
        {
          "input": "4\n2 7 11 15\n9",
          "output": "0 1",
          "explanation": "nums[0] + nums[1] = 2 + 7 = 9"
        },
        {
          "input": "3\n3 2 4\n6",
          "output": "1 2"
        }
      ],
