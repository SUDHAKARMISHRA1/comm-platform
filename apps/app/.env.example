# Public values only. Never put the service role key in the product app.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Coding platform API (Next.js backend). Default: http://localhost:3000/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000/api

# Set to true to use in-app mock data without the backend
EXPO_PUBLIC_USE_MOCK_API=true

# Public web origin used for canonical / Open Graph URLs (optional)
EXPO_PUBLIC_SITE_URL=http://localhost:8081
