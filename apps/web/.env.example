# Public (safe for the browser bundle)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# URL where the Expo product web app is running. Local default: http://localhost:8081
NEXT_PUBLIC_PRODUCT_APP_URL=http://localhost:8081

# Server-only. Never prefix with NEXT_PUBLIC_. Used by the admin portal.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Judge0 (server-only). Leave unset to use mock execution in API routes.
JUDGE0_BASE_URL=http://localhost:2358
JUDGE0_API_KEY=

# Coding data store (JSON file, migrates to Postgres via 0002_coding.sql)
CODING_DATA_DIR=../../data/coding
